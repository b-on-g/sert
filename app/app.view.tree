$bog_sert_app $mol_view
	sub <= app_body /
		<= Desk $bog_sert_desk
		<= Sheet $mol_page
			title <= sheet_title \Сертификат
			tools /
				<= Home $mol_link
					title \Сертификаты
					arg *
						cert null
						pass null
						bz null
						bzname null
						page null
				<= Theme_toggle $bog_theme_toggle
					theme_auto <= Theme
			body /
				<= Sheet_card $bog_sert_sheet
					uri <= cert_uri \
		<= Front $mol_page
			title <= front_title \Салон
			tools /
				<= Home
				<= Theme_toggle
			body /
				<= Front_body $bog_sert_front
					uri <= shop_uri \
		<= Card $mol_page
			title \Карта гостя
			tools /
				<= Home
				<= Theme_toggle
			body /
				<= Card_body $bog_sert_card
					uri <= pass_uri \
		<= Rivals $mol_page
			title \Имя занято дважды
			tools /
				<= Home
				<= Theme_toggle
			body /
				<= Rivals_hint $mol_text
					text \
						\На это имя претендует несколько салонов. Имя в адресе не защищено, поэтому угадывать за вас мы не будем: выберите, куда идти, и дальше пользуйтесь прямой ссылкой.
				<= Rivals_list $mol_list
					rows <= rival_rows /
	Rival* $mol_link
		title <= rival_title* \
		arg *
			bzname null
			bz <= rival_uri* \
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
