		cert_uri <= row_uri* \

$bog_sert_desk_loyalty $bog_sert_page
	title \Лояльность
	body /
		<= Hint $mol_text
			text \
				\Гость сканирует код на стойке и заводит себе карту. Само по себе это не даёт ему ничего, поэтому плодить карты бессмысленно и защищаться тут не от чего.
				\
				\Баллы начисляет только касса, своим ключом, в книгу операций салона. Подделать запись гость не может: писать в эту книгу он не вправе.
		<= Form $mol_list
			rows /
				<= Rate_field $mol_form_field
					name \Возвращается баллами, % от чека
					control <= Rate $mol_number
						value_min 0
						value_max 100
						precision 1
						value? <=> rate? 5
				<= Bonus_field $mol_form_field
					name \Приветственный бонус, баллов
					control <= Bonus $mol_number
						value_min 0
						precision_change 10
						value? <=> bonus? 0
				<= Price_field $mol_form_field
					name \Сколько рублей стоит один балл при списании
					control <= Price $mol_number
						value_min 0
						precision_view .01
						precision_change .1
						value? <=> price? 1
		<= Sample $mol_text
			text <= sample \

$bog_call_qr_scan $mol_view
	on_decode? null
	scanning true
	sub /
		<= Video $mol_view
			dom_name \video
			attr *
				autoplay true
				playsinline true
				muted true
			field *
				srcObject <= stream null
		<= Hint $mol_view
			sub /
				<= hint @ \Наведите на QR-код

$bog_sert_desk_till $bog_sert_page
	title \Касса
	body <= till_body /
		<= Scan $bog_call_qr_scan
			on_decode? <=> decoded? null
			scanning <= scanning true
		<= Manual_field $mol_form_field
			name \Или введите номер карты
			control <= Manual $mol_string
				hint \r7u17HFT_mY9Rf1P0
				value? <=> manual? \
				submit? <=> manual_apply? null
		<= Manual_apply $mol_button_minor
			title \Найти карту
			enabled <= manual_allowed true
			click? <=> manual_apply? null
		<= Guest $mol_list
			rows <= guest_rows /
				<= Guest_head $mol_view
					sub /
						<= guest_title \
				<= Balance $mol_view
					sub /
						<= balance_text \
				<= Cost_field $mol_form_field
					name \Сумма чека, ₽
					control <= Cost $mol_number
						value_min 0
						precision_change 100
						value? <=> cost? 0
				<= Accrual $mol_view
					sub /
						<= accrual_text \
				<= Welcome $mol_check
					title <= welcome_title \Приветственный бонус
					checked? <=> welcome? true
				<= Accrue $mol_button_major
					title \Начислить
					enabled <= accrue_allowed true
					click? <=> accrue? null
				<= Writeoff_field $mol_form_field
					name \Списать баллов
					control <= Writeoff $mol_number
						value_min 0
						precision_change 10
						value? <=> writeoff? 0
				<= Spend $mol_button_minor
					title \Списать
					enabled <= spend_allowed true
					click? <=> spend? null
				<= Reset $mol_button_minor
					title \Другая карта
					click? <=> reset? null
		<= Done $mol_status
			message <= done \

$bog_sert_desk_guests_row $mol_view
