		last <= row_last* \

$bog_sert_key $mol_list
	rows /
		<= Intro $mol_text
			text \
				\## Ключ доступа
				\
				\Аккаунта и пароля тут нет. Всё, что у вас есть — ключ, который браузер завёл сам при первом открытии и держит только на этом устройстве. Кабинет салона и право гасить сертификаты привязаны именно к нему.
				\
				\Чтобы зайти в тот же кабинет с телефона на ресепшене, скопируйте ключ отсюда и вставьте его там. Кто держит ключ, тот и салон, так что пересылать его через общий чат не стоит.
				\
				\Ключ живёт в хранилище браузера. Очистите данные сайта, и кабинет вместе со всеми сертификатами станет недоступен. Держите копию.
		<= Mine_field $mol_form_field
			name \Ваш ключ
			control <= Mine $bog_sert_area
				enabled false
				value <= mine \
		<= Copy $mol_button_minor
			title \Скопировать ключ
			click? <=> copy? null
		<= Other_field $mol_form_field
			name \Войти чужим ключом
			control <= Other $bog_sert_area
				hint \Вставьте сюда ключ, скопированный на другом устройстве
				value? <=> other? \
		<= Enter $mol_button_major
			title \Войти этим ключом
			enabled <= enter_allowed true
			click? <=> enter? null
		<= Result $mol_status
			message <= result \

$bog_sert_desk $mol_book2_catalog
	param \page
	menu_title \Кабинет
	shop_uri \
	menu_tools /
		<= Pass_link $mol_link
			title \Моя карта
			arg *
				page null
				pass <= pass_uri \
	spreads *
		shop <= Shop_page $bog_sert_desk_shop
			shop_uri <= shop_uri
			tools / <= Spread_close
		issue <= Issue_page $bog_sert_desk_issue
			shop_uri <= shop_uri
			tools / <= Spread_close
		certs <= Certs_page $bog_sert_desk_certs
			shop_uri <= shop_uri
			tools / <= Spread_close
		loyalty <= Loyalty_page $bog_sert_desk_loyalty
			shop_uri <= shop_uri
			tools / <= Spread_close
		till <= Till_page $bog_sert_desk_till
			shop_uri <= shop_uri
			tools / <= Spread_close
		guests <= Guests_page $bog_sert_desk_guests
			shop_uri <= shop_uri
			tools / <= Spread_close
		key <= Key_page $mol_page
			title \Ключ доступа
			tools / <= Spread_close
			body /
				<= Key $bog_sert_key
	Spread_default <= Start_page $mol_page
		title \Сертификаты и бонусы
		body <= start_body /
			<= Intro $mol_text
				text \
					\## Свой салон
					\
					\Заведите салон, чтобы выпускать подарочные сертификаты и начислять бонусы. Ни почты, ни пароля не спросим: доступ держится на ключе, который браузер завёл сам.
			<= Make $mol_button_major
				title \Завести салон
				click? <=> shop_make? null
			<= Ready $mol_text
				text \
					\## Салон готов
					\
					\Выберите раздел слева. В «Салоне» лежат реквизиты и адрес витрины, в «Кассе» начисляются бонусы по карте гостя.

