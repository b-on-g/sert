	Link* $mol_link_iconed
		uri <= link_uri* \
		content <= line_content* /
	Link_http* $mol_link_iconed
		uri <= link_uri* \
		content / <= link_host* \
	Embed* $mol_embed_any
		uri <= link_uri* \
		title <= line_text* \
	- \Spoilers
	Spoiler* $mol_expander
		label /
			<= Spoiler_label* $mol_text
				text <= spoiler_label* \
		content /
			<= Spoiler_content* $mol_text
				text <= spoiler_content* \

$mol_text_header $mol_paragraph
	level 1
	sub /
		<= Link $mol_link
			arg <= arg *
			hint @ \Permalink to this section
			sub <= content /

$mol_text_span $mol_paragraph
	dom_name \span
	attr *
		^
		mol_text_type <= type \

$bog_qr $mol_svg_root
	uri \
	module_radius 0.35
	finder_radius 1.2
	gradient_angle 45
	error_correction \M
	quiet_zone 2
	center /
	gradient_id \qr-grad
	gradient_fill \url(#qr-grad)
	gradient_stops /
		\var(--mol_theme_special)
		\var(--mol_theme_focus)
	Stop* $mol_svg
		dom_name \stop
		attr *
			^
			offset <= stop_offset* \0%
			stop-color <= stop_color* \
	view_box <= qr_view_box \0 0 1 1
	sub /
		<= Defs $mol_svg
			dom_name \defs
			sub /
				<= Gradient $mol_svg
					dom_name \linearGradient
					attr *
						^
						id <= gradient_id
						x1 <= grad_x1 \0
						y1 <= grad_y1 \0
						x2 <= grad_x2 \1
						y2 <= grad_y2 \1
					sub <= gradient_stop_list /
		<= Modules $mol_svg_path
			geometry <= modules_d \
			attr *
				^
				fill <= gradient_fill
		<= Rings $mol_svg_path
			geometry <= rings_d \
			attr *
				^
				fill <= gradient_fill
				fill-rule \evenodd
		<= Centers $mol_svg_path
			geometry <= centers_d \
			attr *
				^
				fill <= gradient_fill
		<= Center_wrap $mol_svg
			dom_name \foreignObject
			attr *
				^
				x <= center_x \0
				y <= center_y \0
				width <= center_size \0
				height <= center_size
			sub /
				<= Center_body $mol_view
					sub <= center

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_status $mol_view
	status <= title
	minimal_height 24
	minimal_width 0
	sub /
		<= message \

$mol_row $mol_view

$mol_form $mol_list
	submit_allowed true
	submit_blocked false
	event *
		^
		keydown? <=> keydown? null
	save? null
	message_done @ \Saved
	errors *string
		\Form invalid
			<= form_invalid @ \Form is not valid
	rows /
		<= Body $mol_list
			sub <= body <= form_fields /$mol_form_field
		<= Foot $mol_row
			sub <= foot <= buttons /$mol_view
				<= Submit $mol_button_major
					title <= submit_title @ \Save
					hint <= submit_hint \
					activate? => submit_activate?
					click? <=> submit? null
				<= Result $mol_status
					message <= result? null

$mol_text_list $mol_text
	auto_scroll null
	attr *
		^
		mol_text_list_type <= type \
	Paragraph* $mol_text_list_item
		index <= item_index*
		sub <= block_content*

$mol_text_list_item $mol_paragraph
	attr *
		^
		mol_text_list_item_index <= index 0

$bog_sert_desk_shop $bog_sert_page
	title \Салон
	body /
		<= Form $mol_list
			rows /
				<= Name_field $mol_form_field
					name \Название
					control <= Name $mol_string
						hint \Барбершоп «Бритва»
						value? <=> shop_name? \
				<= Note_field $mol_form_field
					name \Адрес, телефон, условия
					control <= Note $bog_sert_area
						hint \Ленина 1 · +7 900 000-00-00 · запись по телефону
						value? <=> shop_note? \
				<= Term_field $mol_form_field
					name \Срок действия сертификата, месяцев
					control <= Term $mol_number
						value_min 0
						value_max 60
						precision 1
						value? <=> shop_term? 6
		<= Address_block $mol_list
			rows <= address_rows /
				<= Address_title $mol_view
					sub /
						\Витрина
				<= Address_hint $mol_text
					text \
						\Распечатайте этот код и положите на стойку. Гость сканирует его телефоном, открывает витрину и заводит карту. Ничего заполнять и никуда регистрироваться ему не придётся.
				<= Address_value $mol_view
					sub /
						<= address \
				<= Address_copy $mol_button_minor
					title \Скопировать адрес
					click? <=> address_copy? null
				<= Code $bog_qr
					uri <= address \
					error_correction \M
		<= Claim_block $mol_list
			rows /
				<= Claim_title $mol_view
					sub /
						\Короткое имя
				<= Claim_hint $mol_text
					text \
						\Имя делает адрес читаемым, но не защищает его: занять то же имя технически может кто угодно.
						\
						\Сертификаты и карты гостей всегда ссылаются на сам салон, поэтому имя можно потерять без последствий.
				<= Claim_field $mol_form_field
					name \Имя в адресе
					control <= Claim $mol_string
						hint \coffier_shopper
						value? <=> claim_raw? \
				<= Claim_take $mol_button_major
					title \Занять имя
					enabled <= claim_allowed true
					click? <=> claim_take? null
				<= Claim_status $mol_status
					message <= claim_status \

$bog_sert_sheet $mol_list
	uri \
	rows <= card_rows /
		<= Empty $mol_status
			message \Ссылка не похожа на сертификат
		<= Sheet $mol_view
			sub <= sheet /
				<= Head $mol_view
					sub /
						<= Shop $mol_view
							sub /
								<= shop \
						<= Kind $mol_view
							sub /
								<= kind \Подарочный сертификат
				<= Gift $mol_view
					sub /
						<= gift \
				<= Names $mol_view
					sub /
						<= Whom $mol_view
							sub /
								<= whom \
						<= From $mol_view
							sub /
								<= from \
				<= Wish $mol_paragraph
					title <= wish \
				<= Foot $mol_view
					sub /
						<= Legend $mol_view
							sub /
								<= legend \
						<= Note $mol_view
							sub /
								<= note \
				<= Stamp $mol_view
					sub /
						<= stamp \
		<= Aside $mol_view
			sub /
				<= Code $bog_qr
					uri <= page_uri \
					error_correction \M
				<= Ident $mol_view
					sub /
						<= Ident_label $mol_view
							sub /
								\Номер сертификата
						<= Ident_value $mol_view
							sub /
								<= ident \
		<= Tools $mol_view
			sub <= tools /
				<= Mail $mol_link
					uri <= mail_uri \
					title <= mail_title \Отправить почтой
					hint \Откроется почтовая программа с готовым письмом
				<= Copy $mol_button_minor
					title <= copy_title \Скопировать ссылку
					click? <=> copy? null
				<= Redeem $mol_button_major
					title <= redeem_title \Погасить
					hint \Отметить сертификат использованным
					click? <=> redeem? null

$bog_sert_desk_issue $bog_sert_page
	title \Выпустить сертификат
	body <= issue_body /
		<= Form $mol_list
			rows /
				<= Gift_field $mol_form_field
					name \Услуга или повод
					control <= Gift $mol_string
						hint \Стрижка и борода
						value? <=> gift? \
				<= Cost_field $mol_form_field
					name \Номинал в рублях, 0 — сертификат на услугу
					control <= Cost $mol_number
						value_min 0
						precision_change 100
						value? <=> cost? 0
				<= Whom_field $mol_form_field
					name \Кому
					control <= Whom $mol_string
						hint \Анна
						value? <=> whom? \
				<= From_field $mol_form_field
					name \От кого
					control <= From $mol_string
						hint \Мама и папа
						value? <=> from? \
				<= Mail_field $mol_form_field
					name \Почта получателя
					control <= Mail $mol_string
						type \email
						hint \anna@example.com
						value? <=> mail? \
				<= Wish_field $mol_form_field
					name \Поздравление
					control <= Wish $bog_sert_area
						hint \С днём рождения!
						value? <=> wish? \
				<= Issue $mol_button_major
					title \Выпустить
					enabled <= issue_allowed true
					click? <=> issue? null
		<= Last_block $mol_list
			rows /
				<= Last_title $mol_view
					sub /
						\Только что выпущен
				<= Last_sheet $bog_sert_sheet
					uri <= last \

$bog_sert_desk_certs_row $mol_link
	cert_uri \
	arg *
		screen null
		cert <= cert_uri
	sub /
