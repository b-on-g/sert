$bog_sert_desk $mol_book2_catalog
	param \page
	menu_title \Кабинет
	shop_uri \
	menu_tools /
		<= Pass_link $mol_link
			title \Моя карта
			arg *
				page null
				pass <= pass_uri \
	spreads *
		shop <= Shop_page $bog_sert_desk_shop
			shop_uri <= shop_uri
			tools / <= Spread_close
		issue <= Issue_page $bog_sert_desk_issue
			shop_uri <= shop_uri
			tools / <= Spread_close
		certs <= Certs_page $bog_sert_desk_certs
			shop_uri <= shop_uri
			tools / <= Spread_close
		loyalty <= Loyalty_page $bog_sert_desk_loyalty
			shop_uri <= shop_uri
			tools / <= Spread_close
		till <= Till_page $bog_sert_desk_till
			shop_uri <= shop_uri
			tools / <= Spread_close
		guests <= Guests_page $bog_sert_desk_guests
			shop_uri <= shop_uri
			tools / <= Spread_close
		crew <= Crew_page $bog_sert_desk_crew
			shop_uri <= shop_uri
			tools / <= Spread_close
		key <= Key_page $mol_page
			title \Ключ доступа
			tools / <= Spread_close
			body /
				<= Key $bog_sert_key
	Spread_default <= Start_page $mol_page
		title \Сертификаты и бонусы
		body <= start_body /
			<= Intro $mol_text
				text \
					\## Свой салон
					\
					\Заведите салон, чтобы выпускать подарочные сертификаты и начислять бонусы. Ни почты, ни пароля не спросим: доступ держится на ключе, который браузер завёл сам.
			<= Make $mol_button_major
				title \Завести салон
				click? <=> shop_make? null
			<= Ready $mol_text
				text \
					\## Салон готов
					\
					\Выберите раздел слева. В «Салоне» лежат реквизиты и адрес витрины, в «Кассе» начисляются бонусы по карте гостя.
			<= Hired $mol_text
				text \
					\## Вы в бригаде
					\
					\Открыт чужой салон: начислять баллы и смотреть гостей можно, менять реквизиты и условия — нет.
