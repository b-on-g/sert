$bog_sert_card $mol_list
	uri \
	rows <= card_rows /
		<= Empty $mol_status
			message \Ссылка не похожа на карту
		<= Head $mol_view
			sub /
				<= Kind $mol_view
					sub /
						\Карта гостя
				<= Total $mol_view
					sub /
						<= total \
		<= Code $bog_qr
			uri <= page_uri \
			error_correction \M
		<= Ident $mol_view
			sub /
				<= Ident_label $mol_view
					sub /
						\Номер карты
				<= Ident_value $mol_view
					sub /
						<= ident \
		<= Shops $mol_list
			rows <= shop_rows /
		<= Save $mol_text
			text \
				\Сохраните эту страницу в закладки или добавьте на домашний экран. Карта живёт в этом браузере: очистите данные сайта, и баллы останутся у салона, но открыть их будет нечем.
	Shop_row* $bog_sert_card_row
		shop_uri <= row_uri* \
		ops <= ops /
